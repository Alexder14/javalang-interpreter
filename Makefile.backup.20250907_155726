CC = gcc
CFLAGS = -Wall -std=c99 -g
INCLUDES = -Iinclude -Iparser
LIBS = -lfl

# Directorios
SRCDIR = src
LEXDIR = lexer
PARSEDIR = parser
EXAMPLEDIR = examples

# Archivos fuente
LEXER_SRC = $(LEXDIR)/lexer.l
PARSER_SRC = $(PARSEDIR)/parser.y
MAIN_SRC = $(SRCDIR)/main.c
COMMON_SRC = $(SRCDIR)/common.c
AST_SRC = $(SRCDIR)/ast.c

# Archivos generados
LEXER_GEN = $(LEXDIR)/lex.yy.c
PARSER_GEN = $(PARSEDIR)/parser.tab.c
PARSER_HDR = $(PARSEDIR)/parser.tab.h

# Ejecutable principal
TARGET = javalang_interpreter

# Regla principal - Compilar interpretador completo con parser integrado
all: $(TARGET)

# Compilar el interpretador principal con todas las dependencias
$(TARGET): $(LEXER_GEN) $(PARSER_GEN) $(MAIN_SRC) $(COMMON_SRC) $(AST_SRC)
	@echo "🔨 Compilando interpretador JavaLang completo..."
	$(CC) $(CFLAGS) $(INCLUDES) -o $(TARGET) \
		$(MAIN_SRC) $(COMMON_SRC) $(AST_SRC) \
		$(LEXER_GEN) $(PARSER_GEN) $(LIBS) 2>/dev/null || \
	$(CC) $(CFLAGS) $(INCLUDES) -o $(TARGET) \
		$(MAIN_SRC) $(COMMON_SRC) $(AST_SRC) \
		$(LEXER_GEN) $(PARSER_GEN)
	@echo "✅ Interpretador compilado exitosamente"

# Generar lexer con Flex
$(LEXER_GEN): $(LEXER_SRC)
	@echo "📝 Generando analizador léxico..."
	flex -o $(LEXER_GEN) $(LEXER_SRC)

# Generar parser con Bison
$(PARSER_GEN): $(PARSER_SRC)
	@echo "📝 Generando analizador sintáctico..."
	bison -d -o $(PARSER_GEN) $(PARSER_SRC)

# Verificar que los directorios y archivos existen
check-files:
	@echo "🔍 Verificando archivos del proyecto..."
	@test -f $(LEXER_SRC) || (echo "❌ $(LEXER_SRC) no encontrado" && exit 1)
	@test -f $(PARSER_SRC) || (echo "❌ $(PARSER_SRC) no encontrado" && exit 1)
	@test -f $(MAIN_SRC) || (echo "❌ $(MAIN_SRC) no encontrado" && exit 1)
	@test -f $(COMMON_SRC) || (echo "❌ $(COMMON_SRC) no encontrado" && exit 1)
	@test -f $(AST_SRC) || (echo "❌ $(AST_SRC) no encontrado" && exit 1)
	@echo "✅ Todos los archivos fuente encontrados"

# Verificar herramientas de desarrollo
check-tools:
	@echo "🛠️  Verificando herramientas..."
	@which gcc > /dev/null && echo "✅ GCC disponible" || echo "❌ GCC no encontrado"
	@which flex > /dev/null && echo "✅ Flex disponible" || echo "❌ Flex no encontrado"
	@which bison > /dev/null && echo "✅ Bison disponible" || echo "❌ Bison no encontrado"

# Ejecutar pruebas básicas
test: $(TARGET)
	@echo "🧪 Ejecutando batería de pruebas..."
	@echo ""
	@echo "📝 Test 1: Archivo básico sin opciones"
	./$(TARGET) $(EXAMPLEDIR)/test1.usl
	@echo ""
	@echo "📝 Test 2: Con reportes"
	./$(TARGET) -r $(EXAMPLEDIR)/test1.usl
	@echo ""
	@echo "📝 Test 3: Modo verbose"
	./$(TARGET) --verbose $(EXAMPLEDIR)/test_completo.usl
	@echo ""
	@echo "📝 Test 4: Visualización completa"
	./$(TARGET) -V $(EXAMPLEDIR)/test1.usl

# Probar solo análisis sintáctico
test-syntax: $(TARGET)
	@echo "🔍 Probando análisis sintáctico..."
	./$(TARGET) $(EXAMPLEDIR)/test1.usl

# Probar con reportes
test-reports: $(TARGET)
	@echo "📊 Probando generación de reportes..."
	./$(TARGET) -r $(EXAMPLEDIR)/test_completo.usl

# Probar modo verbose
test-verbose: $(TARGET)
	@echo "🔍 Probando modo verbose..."
	./$(TARGET) --verbose $(EXAMPLEDIR)/test1.usl

# Generar archivos de ejemplo si no existen
create-examples:
	@echo "📁 Creando archivos de ejemplo..."
	@mkdir -p $(EXAMPLEDIR)
	@if [ ! -f $(EXAMPLEDIR)/test1.usl ]; then \
		echo 'public static void main(String[] args) { int x = 5; System.out.println(x); }' > $(EXAMPLEDIR)/test1.usl; \
		echo "✅ $(EXAMPLEDIR)/test1.usl creado"; \
	fi

# Limpiar archivos generados
clean:
	@echo "🧹 Limpiando archivos generados..."
	rm -f $(TARGET)
	rm -f $(LEXER_GEN) $(PARSER_GEN) $(PARSER_HDR)
	rm -f ast_output.dot ast.png
	rm -f *.o
	@echo "✅ Limpieza completada"

# Limpiar solo el ejecutable
clean-exe:
	rm -f $(TARGET)

# Reconstruir completamente
rebuild: clean all

# Compilar en modo debug con símbolos adicionales
debug: CFLAGS += -DDEBUG -O0
debug: $(TARGET)
	@echo "🐛 Compilado en modo debug"

# Compilar optimizado para release
release: CFLAGS += -O2 -DNDEBUG
release: $(TARGET)
	@echo "🚀 Compilado en modo release"

# Mostrar ayuda
help:
	@echo "🛠️  MAKEFILE JAVALANG - COMANDOS DISPONIBLES"
	@echo "============================================="
	@echo ""
	@echo "📦 COMPILACIÓN:"
	@echo "  make              - Compilar interpretador principal"
	@echo "  make debug        - Compilar en modo debug"
	@echo "  make release      - Compilar optimizado"
	@echo "  make rebuild      - Limpiar y recompilar"
	@echo ""
	@echo "🧪 PRUEBAS:"
	@echo "  make test         - Ejecutar batería completa de pruebas"
	@echo "  make test-syntax  - Probar solo análisis sintáctico"
	@echo "  make test-reports - Probar generación de reportes"
	@echo "  make test-verbose - Probar modo verbose"
	@echo ""
	@echo "🔍 VERIFICACIÓN:"
	@echo "  make check-tools  - Verificar herramientas (gcc, flex, bison)"
	@echo "  make check-files  - Verificar archivos fuente"
	@echo ""
	@echo "🧹 LIMPIEZA:"
	@echo "  make clean        - Limpiar todos los archivos generados"
	@echo "  make clean-exe    - Limpiar solo el ejecutable"
	@echo ""
	@echo "📁 UTILIDADES:"
	@echo "  make create-examples - Crear archivos de ejemplo básicos"
	@echo ""
	@echo "💡 EJEMPLOS DE USO:"
	@echo "  make && make test"
	@echo "  make clean && make debug && make test-verbose"

# Mostrar información del proyecto
info:
	@echo "📋 INFORMACIÓN DEL PROYECTO JAVALANG"
	@echo "===================================="
	@echo "🎯 Objetivo: Compilador e intérprete educativo"
	@echo "🏫 Universidad: San Carlos de Guatemala"
	@echo "📚 Curso: Organización de Lenguajes y Compiladores 2"
	@echo ""
	@echo "📁 Estructura:"
	@echo "  - $(SRCDIR)/: Código fuente principal"
	@echo "  - $(LEXDIR)/: Analizador léxico (Flex)"
	@echo "  - $(PARSEDIR)/: Analizador sintáctico (Bison)"
	@echo "  - $(EXAMPLEDIR)/: Archivos de prueba (.usl)"
	@echo ""
	@echo "✅ Estado: Fase 4 - Análisis Semántico Completado"

# Crear un backup del proyecto
backup:
	@echo "💾 Creando backup del proyecto..."
	tar -czf javalang_backup_$(shell date +%Y%m%d_%H%M%S).tar.gz \
		$(SRCDIR) $(LEXDIR) $(PARSEDIR) $(EXAMPLEDIR) include Makefile *.md 2>/dev/null || true
	@echo "✅ Backup creado"

# Reglas que no son archivos
.PHONY: all clean clean-exe rebuild test test-syntax test-reports test-verbose 
.PHONY: check-tools check-files create-examples help info backup debug release

# Dependencias
$(TARGET): check-files