Grammar

    0 $accept: program $end

    1 program: main_class

    2 main_class: PUBLIC STATIC VOID MAIN LPAREN RPAREN block_statement
    3           | PUBLIC STATIC VOID MAIN LPAREN STRING_TYPE LBRACKET RBRACKET IDENTIFIER RPAREN block_statement

    4 function_declaration: PUBLIC STATIC type_specifier IDENTIFIER LPAREN parameter_list RPAREN block_statement
    5                     | PUBLIC STATIC type_specifier IDENTIFIER LPAREN RPAREN block_statement
    6                     | PUBLIC STATIC VOID IDENTIFIER LPAREN parameter_list RPAREN block_statement
    7                     | PUBLIC STATIC VOID IDENTIFIER LPAREN RPAREN block_statement

    8 parameter_list: parameter
    9               | parameter_list COMMA parameter

   10 parameter: type_specifier IDENTIFIER
   11          | type_specifier LBRACKET RBRACKET IDENTIFIER

   12 block_statement: LBRACE statement_list RBRACE
   13                | LBRACE RBRACE

   14 statement_list: statement
   15               | statement_list statement
   16               | statement_list function_declaration

   17 statement: variable_declaration
   18          | assignment_statement
   19          | expression_statement
   20          | if_statement
   21          | while_statement
   22          | for_statement
   23          | do_while_statement
   24          | switch_statement
   25          | block_statement
   26          | BREAK SEMICOLON
   27          | CONTINUE SEMICOLON
   28          | RETURN SEMICOLON
   29          | RETURN expression SEMICOLON

   30 variable_declaration: type_specifier IDENTIFIER SEMICOLON
   31                     | type_specifier IDENTIFIER ASSIGN expression SEMICOLON
   32                     | type_specifier LBRACKET RBRACKET IDENTIFIER SEMICOLON
   33                     | type_specifier LBRACKET RBRACKET IDENTIFIER ASSIGN array_initialization SEMICOLON
   34                     | FINAL type_specifier IDENTIFIER ASSIGN expression SEMICOLON

   35 assignment_statement: IDENTIFIER assignment_operator expression SEMICOLON
   36                     | array_access assignment_operator expression SEMICOLON

   37 assignment_operator: ASSIGN
   38                    | PLUS_ASSIGN
   39                    | MINUS_ASSIGN
   40                    | MULT_ASSIGN
   41                    | DIV_ASSIGN
   42                    | MOD_ASSIGN

   43 expression_statement: expression SEMICOLON

   44 if_statement: IF LPAREN expression RPAREN statement
   45             | IF LPAREN expression RPAREN statement ELSE statement

   46 while_statement: WHILE LPAREN expression RPAREN statement

   47 for_statement: FOR LPAREN assignment_statement expression SEMICOLON assignment_statement RPAREN statement
   48              | FOR LPAREN variable_declaration expression SEMICOLON assignment_statement RPAREN statement

   49 do_while_statement: DO statement WHILE LPAREN expression RPAREN SEMICOLON

   50 switch_statement: SWITCH LPAREN expression RPAREN LBRACE case_list RBRACE

   51 case_list: case_statement
   52          | case_list case_statement

   53 case_statement: CASE expression COLON statement_list
   54               | DEFAULT COLON statement_list

   55 expression: primary_expression
   56           | expression PLUS expression
   57           | expression MINUS expression
   58           | expression MULTIPLY expression
   59           | expression DIVIDE expression
   60           | expression MODULO expression
   61           | expression EQUAL expression
   62           | expression NOT_EQUAL expression
   63           | expression LESS expression
   64           | expression LESS_EQUAL expression
   65           | expression GREATER expression
   66           | expression GREATER_EQUAL expression
   67           | expression AND expression
   68           | expression OR expression
   69           | expression BIT_AND expression
   70           | expression BIT_OR expression
   71           | expression BIT_XOR expression
   72           | NOT expression
   73           | BIT_NOT expression
   74           | MINUS expression
   75           | PLUS expression
   76           | IDENTIFIER INCREMENT
