%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "ast.h"
#include "common.h"
#include "semantic.h"

// Funciones externas
extern int yylex();
extern FILE *yyin;
extern int line_num;
extern int col_num;

// Función de error
void yyerror(const char *s);

// Variables globales
extern ASTNode *ast_root;
%}

// Definir tipos de valores
%union {
    int int_val;
    float float_val;
    char char_val;
    char *str_val;
    ASTNode *node;
    bool bool_val;
}

// Tokens del lexer
%token <str_val> IDENTIFIER STRING_LITERAL
%token <int_val> INT_LITERAL
%token <float_val> FLOAT_LITERAL
%token <char_val> CHAR_LITERAL
%token <bool_val> TRUE FALSE

// Palabras reservadas
%token PUBLIC PRIVATE PROTECTED STATIC FINAL VOID MAIN
%token INT FLOAT DOUBLE BOOLEAN CHAR STRING_TYPE
%token IF ELSE SWITCH CASE DEFAULT WHILE FOR DO
%token BREAK CONTINUE RETURN
%token NULL_VAL NEW THIS

// Operadores
%token PLUS MINUS MULTIPLY DIVIDE MODULO
%token INCREMENT DECREMENT
%token ASSIGN PLUS_ASSIGN MINUS_ASSIGN MULT_ASSIGN DIV_ASSIGN MOD_ASSIGN
%token EQUAL NOT_EQUAL LESS LESS_EQUAL GREATER GREATER_EQUAL
%token AND OR NOT
%token BIT_AND BIT_OR BIT_XOR BIT_NOT LEFT_SHIFT RIGHT_SHIFT

// Delimitadores
%token LPAREN RPAREN LBRACE RBRACE LBRACKET RBRACKET
%token SEMICOLON COMMA DOT COLON QUESTION

// Funciones embebidas
%token PRINTLN PRINT PARSE_INT PARSE_FLOAT PARSE_DOUBLE
%token VALUE_OF STRING_JOIN ARRAY_INDEX_OF

// **TIPOS DE NODOS - USANDO TUS FUNCIONES EXISTENTES**
%type <node> program main_class
%type <node> function_declaration_list function_declaration
%type <node> parameter_list parameter
%type <node> statement_list statement
%type <node> variable_declaration assignment_statement
%type <node> expression_statement if_statement while_statement 
%type <node> for_statement do_while_statement switch_statement 
%type <node> case_list case_statement default_case block_statement
%type <node> expression arithmetic_expression logical_expression
%type <node> relational_expression primary_expression
%type <node> function_call argument_list
%type <node> data_type return_statement break_statement continue_statement
%type <node> print_statement println_statement

// Precedencia y asociatividad
%right ASSIGN PLUS_ASSIGN MINUS_ASSIGN MULT_ASSIGN DIV_ASSIGN MOD_ASSIGN
%left OR
%left AND
%left BIT_OR
%left BIT_XOR
%left BIT_AND
%left EQUAL NOT_EQUAL
%left LESS LESS_EQUAL GREATER GREATER_EQUAL
%left LEFT_SHIFT RIGHT_SHIFT
%left PLUS MINUS
%left MULTIPLY DIVIDE MODULO
%right NOT BIT_NOT INCREMENT DECREMENT UNARY_MINUS
%left DOT
%left LBRACKET RBRACKET
%left LPAREN RPAREN

%start program

%%

// **PROGRAMA PRINCIPAL**
program: main_class function_declaration_list {
    $$ = create_program_node($2);
    add_to_list($$, $1);
    ast_root = $$;
    printf("✅ AST construido correctamente\n");
}
| main_class {
    $$ = create_program_node(NULL);
    add_to_list($$, $1);
    ast_root = $$;
    printf("✅ AST construido correctamente (solo main)\n");
};

// **CLASE PRINCIPAL CON MAIN**
main_class: PUBLIC STATIC VOID MAIN LPAREN STRING_TYPE LBRACKET RBRACKET IDENTIFIER RPAREN LBRACE statement_list RBRACE {
    $$ = create_main_class_node($12);
    printf("✅ Método main reconocido\n");
};

// **LISTA DE FUNCIONES**
function_declaration_list: function_declaration_list function_declaration {
    $$ = $1;
    add_to_list($$, $2);
}
| function_declaration {
    $$ = create_list_node();
    add_to_list($$, $1);
}
| /* vacío */ {
    $$ = create_list_node();
};

// **DECLARACIÓN DE FUNCIÓN**
function_declaration: PUBLIC STATIC data_type IDENTIFIER LPAREN parameter_list RPAREN LBRACE statement_list RBRACE {
    // Extraer nombre del tipo de datos
    char *return_type = ($3 && $3->data.type.name) ? $3->data.type.name : "void";
    $$ = create_function_decl_node(return_type, $4, $6, $9);
    printf("✅ Función '%s' reconocida\n", $4);
}
| PUBLIC STATIC data_type IDENTIFIER LPAREN RPAREN LBRACE statement_list RBRACE {
    char *return_type = ($3 && $3->data.type.name) ? $3->data.type.name : "void";
    $$ = create_function_decl_node(return_type, $4, NULL, $8);
    printf("✅ Función '%s' sin parámetros reconocida\n", $4);
};

// **LISTA DE PARÁMETROS**
parameter_list: parameter_list COMMA parameter {
    $$ = $1;
    add_to_list($$, $3);
}
| parameter {
    $$ = create_list_node();
    add_to_list($$, $1);
};

// **PARÁMETRO**
parameter: data_type IDENTIFIER {
    char *type_name = ($1 && $1->data.type.name) ? $1->data.type.name : "int";
    $$ = create_parameter_node(type_name, $2, false);
};

// **TIPOS DE DATOS - USANDO TUS FUNCIONES**
data_type: INT {
    $$ = create_node(NODE_TYPE, line_num, col_num);
    $$->data.type.name = strdup("int");
    $$->data.type.is_array = false;
}
| FLOAT {
    $$ = create_node(NODE_TYPE, line_num, col_num);
    $$->data.type.name = strdup("float");
    $$->data.type.is_array = false;
}
| DOUBLE {
    $$ = create_node(NODE_TYPE, line_num, col_num);
    $$->data.type.name = strdup("double");
    $$->data.type.is_array = false;
}
| BOOLEAN {
    $$ = create_node(NODE_TYPE, line_num, col_num);
    $$->data.type.name = strdup("boolean");
    $$->data.type.is_array = false;
}
| CHAR {
    $$ = create_node(NODE_TYPE, line_num, col_num);
    $$->data.type.name = strdup("char");
    $$->data.type.is_array = false;
}
| STRING_TYPE {
    $$ = create_node(NODE_TYPE, line_num, col_num);
    $$->data.type.name = strdup("String");
    $$->data.type.is_array = false;
};

// **LISTA DE STATEMENTS**
statement_list: statement_list statement {
    $$ = $1 ? $1 : create_list_node();
    add_to_list($$, $2);
}
| statement {
    $$ = create_list_node();
    add_to_list($$, $1);
}
| /* vacío */ {
    $$ = create_list_node();
};

// **STATEMENTS**
statement: variable_declaration { $$ = $1; }
| assignment_statement { $$ = $1; }
| expression_statement { $$ = $1; }
| if_statement { $$ = $1; }
| while_statement { $$ = $1; }
| for_statement { $$ = $1; }
| do_while_statement { $$ = $1; }
| switch_statement { $$ = $1; }
| block_statement { $$ = $1; }
| return_statement { $$ = $1; }
| break_statement { $$ = $1; }
| continue_statement { $$ = $1; }
| print_statement { $$ = $1; }
| println_statement { $$ = $1; };

// **DECLARACIÓN DE VARIABLES - USANDO TUS FUNCIONES**
variable_declaration: data_type IDENTIFIER SEMICOLON {
    char *type_name = ($1 && $1->data.type.name) ? $1->data.type.name : "int";
    $$ = create_var_decl_node(type_name, $2, NULL, false, 0);
    printf("✅ Variable '%s' declarada\n", $2);
}
| data_type IDENTIFIER ASSIGN expression SEMICOLON {
    char *type_name = ($1 && $1->data.type.name) ? $1->data.type.name : "int";
    $$ = create_var_decl_node(type_name, $2, $4, false, 0);
    printf("✅ Variable '%s' declarada e inicializada\n", $2);
};

// **ASIGNACIÓN - USANDO TUS FUNCIONES**
assignment_statement: IDENTIFIER ASSIGN expression SEMICOLON {
    ASTNode *left = create_identifier_node($1);
    $$ = create_assignment_node(left, "=", $3);
    printf("✅ Asignación a '%s'\n", $1);
}
| array_access ASSIGN expression SEMICOLON {
    $$ = create_assignment_node($1, "=", $3);
};

// **STATEMENT DE EXPRESIÓN**
expression_statement: expression SEMICOLON {
    $$ = create_node(NODE_EXPRESSION_STMT, line_num, col_num);
    add_to_list($$, $1);
};

// **IF STATEMENT - USANDO TUS FUNCIONES**
if_statement: IF LPAREN expression RPAREN statement {
    $$ = create_if_node($3, $5, NULL);
}
| IF LPAREN expression RPAREN statement ELSE statement {
    $$ = create_if_node($3, $5, $7);
};

// **WHILE STATEMENT - USANDO TUS FUNCIONES**
while_statement: WHILE LPAREN expression RPAREN statement {
    $$ = create_while_node($3, $5);
};

// **FOR STATEMENT - USANDO TUS FUNCIONES**
for_statement: FOR LPAREN variable_declaration expression SEMICOLON assignment_statement RPAREN statement {
    $$ = create_for_node($3, $4, $6, $8);
}
| FOR LPAREN assignment_statement expression SEMICOLON assignment_statement RPAREN statement {
    $$ = create_for_node($3, $4, $6, $8);
};

// **DO-WHILE STATEMENT**
do_while_statement: DO statement WHILE LPAREN expression RPAREN SEMICOLON {
    $$ = create_node(NODE_DO_WHILE_STMT, line_num, col_num);
    add_to_list($$, $2);
    add_to_list($$, $5);
};

// **SWITCH STATEMENT**
switch_statement: SWITCH LPAREN expression RPAREN LBRACE case_list RBRACE {
    $$ = create_node(NODE_SWITCH_STMT, line_num, col_num);
    add_to_list($$, $3);
    add_to_list($$, $6);
}
| SWITCH LPAREN expression RPAREN LBRACE case_list default_case RBRACE {
    $$ = create_node(NODE_SWITCH_STMT, line_num, col_num);
    add_to_list($$, $3);
    add_to_list($$, $6);
    add_to_list($$, $7);
};

// **LISTA DE CASES**
case_list: case_list case_statement {
    $$ = $1;
    add_to_list($$, $2);
}
| case_statement {
    $$ = create_list_node();
    add_to_list($$, $1);
};

// **CASE STATEMENT**
case_statement: CASE INT_LITERAL COLON statement_list {
    $$ = create_node(NODE_CASE_STMT, line_num, col_num);
    ASTNode *case_value = create_int_literal_node($2);
    add_to_list($$, case_value);
    add_to_list($$, $4);
};

// **DEFAULT CASE**
default_case: DEFAULT COLON statement_list {
    $$ = create_node(NODE_DEFAULT_STMT, line_num, col_num);
    add_to_list($$, $3);
};

// **BLOQUE DE STATEMENTS - USANDO TUS FUNCIONES**
block_statement: LBRACE statement_list RBRACE {
    $$ = create_block_node();
    add_to_list($$, $2);
};

// **RETURN STATEMENT**
return_statement: RETURN SEMICOLON {
    $$ = create_node(NODE_RETURN_STMT, line_num, col_num);
}
| RETURN expression SEMICOLON {
    $$ = create_node(NODE_RETURN_STMT, line_num, col_num);
    add_to_list($$, $2);
};

// **BREAK STATEMENT**
break_statement: BREAK SEMICOLON {
    $$ = create_node(NODE_BREAK_STMT, line_num, col_num);
};

// **CONTINUE STATEMENT**
continue_statement: CONTINUE SEMICOLON {
    $$ = create_node(NODE_CONTINUE_STMT, line_num, col_num);
};

// **PRINT STATEMENTS**
print_statement: PRINT LPAREN expression RPAREN SEMICOLON {
    $$ = create_function_call_node("print", $3);
};

println_statement: PRINTLN LPAREN expression RPAREN SEMICOLON {
    $$ = create_function_call_node("println", $3);
};

// **EXPRESIONES**
expression: arithmetic_expression { $$ = $1; }
| logical_expression { $$ = $1; }
| relational_expression { $$ = $1; }
| primary_expression { $$ = $1; }
| function_call { $$ = $1; };

// **EXPRESIONES ARITMÉTICAS - USANDO TUS FUNCIONES**
arithmetic_expression: expression PLUS expression {
    $$ = create_binary_op_node("+", $1, $3);
}
| expression MINUS expression {
    $$ = create_binary_op_node("-", $1, $3);
}
| expression MULTIPLY expression {
    $$ = create_binary_op_node("*", $1, $3);
}
| expression DIVIDE expression {
    $$ = create_binary_op_node("/", $1, $3);
}
| expression MODULO expression {
    $$ = create_binary_op_node("%", $1, $3);
}
| MINUS expression %prec UNARY_MINUS {
    $$ = create_unary_op_node("-", $2, true);
};

// **EXPRESIONES LÓGICAS - USANDO TUS FUNCIONES**
logical_expression: expression AND expression {
    $$ = create_binary_op_node("&&", $1, $3);
}
| expression OR expression {
    $$ = create_binary_op_node("||", $1, $3);
}
| NOT expression {
    $$ = create_unary_op_node("!", $2, true);
};

// **EXPRESIONES RELACIONALES - USANDO TUS FUNCIONES**
relational_expression: expression LESS expression {
    $$ = create_binary_op_node("<", $1, $3);
}
| expression LESS_EQUAL expression {
    $$ = create_binary_op_node("<=", $1, $3);
}
| expression GREATER expression {
    $$ = create_binary_op_node(">", $1, $3);
}
| expression GREATER_EQUAL expression {
    $$ = create_binary_op_node(">=", $1, $3);
}
| expression EQUAL expression {
    $$ = create_binary_op_node("==", $1, $3);
}
| expression NOT_EQUAL expression {
    $$ = create_binary_op_node("!=", $1, $3);
};

// **EXPRESIONES PRIMARIAS - USANDO TUS FUNCIONES**
primary_expression: IDENTIFIER {
    $$ = create_identifier_node($1);
}
| INT_LITERAL {
    $$ = create_int_literal_node($1);
}
| FLOAT_LITERAL {
    $$ = create_float_literal_node($1);
}
| CHAR_LITERAL {
    $$ = create_char_literal_node($1);
}
| STRING_LITERAL {
    $$ = create_string_literal_node($1);
}
| TRUE {
    $$ = create_boolean_literal_node(true);
}
| FALSE {
    $$ = create_boolean_literal_node(false);
}
| LPAREN expression RPAREN {
    $$ = $2;
}
| array_access {
    $$ = $1;
};

// **ACCESO A ARRAYS - USANDO TUS FUNCIONES**
array_access: IDENTIFIER LBRACKET expression RBRACKET {
    ASTNode *array = create_identifier_node($1);
    $$ = create_array_access_node(array, $3);
};

// **LLAMADAS A FUNCIONES - USANDO TUS FUNCIONES**
function_call: IDENTIFIER LPAREN argument_list RPAREN {
    $$ = create_function_call_node($1, $3);
}
| IDENTIFIER LPAREN RPAREN {
    $$ = create_function_call_node($1, NULL);
};

// **LISTA DE ARGUMENTOS**
argument_list: argument_list COMMA expression {
    $$ = $1 ? $1 : create_list_node();
    add_to_list($$, $3);
}
| expression {
    $$ = create_list_node();
    add_to_list($$, $1);
};

%%

// **FUNCIÓN DE ERROR**
void yyerror(const char *s) {
    printf("❌ Error sintáctico en línea %d, columna %d: %s\n", line_num, col_num, s);
    add_error(ERROR_SYNTACTIC, (char*)s, "Parser", line_num, col_num);
}