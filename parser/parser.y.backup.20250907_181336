%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h> // CORRECCIÓN: Se agregó la librería que faltaba para strdup
#include "ast.h"
#include "common.h"

// Funciones externas
extern int yylex();
extern FILE *yyin;
extern int line_num;
extern int col_num;

// Función de error
void yyerror(const char *s);

// Variables globales
extern ASTNode *ast_root;
%}

// Definir tipos de valores
%union {
    int int_val;
    float float_val;
    char char_val;
    char *str_val;
    ASTNode *node;
    bool bool_val;
}

// Tokens del lexer
%token <str_val> IDENTIFIER STRING_LITERAL
%token <int_val> INT_LITERAL
%token <float_val> FLOAT_LITERAL
%token <char_val> CHAR_LITERAL
%token <bool_val> TRUE FALSE

// Palabras reservadas
%token PUBLIC PRIVATE PROTECTED STATIC FINAL VOID MAIN
%token INT FLOAT DOUBLE BOOLEAN CHAR STRING_TYPE
%token IF ELSE SWITCH CASE DEFAULT WHILE FOR DO
%token BREAK CONTINUE RETURN
%token NULL_VAL NEW THIS

// Operadores
%token PLUS MINUS MULTIPLY DIVIDE MODULO
%token INCREMENT DECREMENT
%token ASSIGN PLUS_ASSIGN MINUS_ASSIGN MULT_ASSIGN DIV_ASSIGN MOD_ASSIGN
%token EQUAL NOT_EQUAL LESS LESS_EQUAL GREATER GREATER_EQUAL
%token AND OR NOT
%token BIT_AND BIT_OR BIT_XOR BIT_NOT LEFT_SHIFT RIGHT_SHIFT

// Delimitadores
%token LPAREN RPAREN LBRACE RBRACE LBRACKET RBRACKET
%token SEMICOLON COMMA DOT COLON QUESTION

// Funciones embebidas
%token PRINTLN PRINT PARSE_INT PARSE_FLOAT PARSE_DOUBLE
%token VALUE_OF STRING_JOIN ARRAY_INDEX_OF

// Tipos de nodos no terminales
%type <node> program main_class
%type <node> statement_list statement
%type <node> variable_declaration assignment_statement
%type <node> expression_statement if_statement while_statement 
%type <node> for_statement do_while_statement switch_statement 
%type <node> case_list case_statement block_statement
%type <node> expression primary_expression
%type <node> function_call argument_list
// CORRECCIÓN: Se eliminó 'array_declaration' que no se usaba
%type <node> array_access array_initialization
%type <str_val> type_specifier assignment_operator

// Precedencia de operadores
%left OR
%left AND
%left BIT_OR
%left BIT_XOR
%left BIT_AND
%left EQUAL NOT_EQUAL
%left LESS LESS_EQUAL GREATER GREATER_EQUAL
%left LEFT_SHIFT RIGHT_SHIFT
%left PLUS MINUS
%left MULTIPLY DIVIDE MODULO
%right NOT BIT_NOT UNARY_MINUS UNARY_PLUS
%right INCREMENT DECREMENT
%left DOT LBRACKET
%left LPAREN

// Símbolo inicial
%start program

%%

program:
    main_class {
        ast_root = create_program_node($1);
        $$ = ast_root;
    }
    ;

main_class:
    PUBLIC STATIC VOID IDENTIFIER LPAREN STRING_TYPE LBRACKET RBRACKET IDENTIFIER RPAREN block_statement {
        if (strcmp($4, "main") != 0) {
            yyerror("Se esperaba función 'main'");
            YYERROR;
        }
        $$ = create_main_class_node($11);
    }
    ;

block_statement:
    LBRACE statement_list RBRACE { $$ = $2; }
    | LBRACE RBRACE { $$ = create_list_node(); }
    ;

statement_list:
    statement {
        ASTNode *list = create_list_node();
        add_to_list(list, $1);
        $$ = list;
    }
    | statement_list statement {
        add_to_list($1, $2);
        $$ = $1;
    }
    ;

statement:
    variable_declaration { $$ = $1; }
    | assignment_statement { $$ = $1; }
    | expression_statement { $$ = $1; }
    | if_statement { $$ = $1; }
    | while_statement { $$ = $1; }
    | for_statement { $$ = $1; }
    | do_while_statement { $$ = $1; }
    | switch_statement { $$ = $1; }
    | block_statement { $$ = $1; }
    | BREAK SEMICOLON { $$ = create_node(NODE_BREAK_STMT, line_num, col_num); }
    | CONTINUE SEMICOLON { $$ = create_node(NODE_CONTINUE_STMT, line_num, col_num); }
    | RETURN SEMICOLON { $$ = create_node(NODE_RETURN_STMT, line_num, col_num); }
    | RETURN expression SEMICOLON {
        ASTNode *node = create_node(NODE_RETURN_STMT, line_num, col_num);
        node->data.return_stmt.value = $2;
        $$ = node;
    }
    ;

variable_declaration:
    type_specifier IDENTIFIER SEMICOLON { $$ = create_var_decl_node($1, $2, NULL, false, 0); }
    | type_specifier IDENTIFIER ASSIGN expression SEMICOLON { $$ = create_var_decl_node($1, $2, $4, false, 0); }
    | type_specifier LBRACKET RBRACKET IDENTIFIER SEMICOLON { $$ = create_var_decl_node($1, $4, NULL, true, 0); }
    | type_specifier LBRACKET INT_LITERAL RBRACKET IDENTIFIER SEMICOLON { $$ = create_var_decl_node($1, $5, NULL, true, $3); }
    | type_specifier IDENTIFIER LBRACKET RBRACKET ASSIGN array_initialization SEMICOLON { $$ = create_var_decl_node($1, $2, $6, true, 0); }
    ;

assignment_statement:
    IDENTIFIER assignment_operator expression SEMICOLON {
        // CORRECCIÓN: Se crea un nodo de identificador para el lado izquierdo
        $$ = create_assignment_node(create_identifier_node($1), $2, $3);
    }
    | array_access assignment_operator expression SEMICOLON {
        // CORRECCIÓN: Se usó 'left' en lugar del inexistente 'target'
        ASTNode* node = create_assignment_node(NULL, $2, $3);
        node->data.assignment.left = $1;
        $$ = node;
    }
    ;

expression_statement:
    expression SEMICOLON { $$ = create_expr_stmt_node($1); }
    ;

expression:
    primary_expression { $$ = $1; }
    // CORRECCIÓN: Se invirtieron los argumentos en todas las llamadas a create_binary_op_node
    | expression PLUS expression { $$ = create_binary_op_node("+", $1, $3); }
    | expression MINUS expression { $$ = create_binary_op_node("-", $1, $3); }
    | expression MULTIPLY expression { $$ = create_binary_op_node("*", $1, $3); }
    | expression DIVIDE expression { $$ = create_binary_op_node("/", $1, $3); }
    | expression MODULO expression { $$ = create_binary_op_node("%", $1, $3); }
    | expression EQUAL expression { $$ = create_binary_op_node("==", $1, $3); }
    | expression NOT_EQUAL expression { $$ = create_binary_op_node("!=", $1, $3); }
    | expression LESS expression { $$ = create_binary_op_node("<", $1, $3); }
    | expression LESS_EQUAL expression { $$ = create_binary_op_node("<=", $1, $3); }
    | expression GREATER expression { $$ = create_binary_op_node(">", $1, $3); }
    | expression GREATER_EQUAL expression { $$ = create_binary_op_node(">=", $1, $3); }
    | expression AND expression { $$ = create_binary_op_node("&&", $1, $3); }
    | expression OR expression { $$ = create_binary_op_node("||", $1, $3); }
    // CORRECCIÓN: Se añadió el 3er argumento 'is_prefix' en las llamadas a create_unary_op_node
    | NOT expression { $$ = create_unary_op_node("!", $2, true); }
    | MINUS expression %prec UNARY_MINUS { $$ = create_unary_op_node("-", $2, true); }
    | PLUS expression %prec UNARY_PLUS { $$ = create_unary_op_node("+", $2, true); }
    | LPAREN expression RPAREN { $$ = $2; }
    | function_call { $$ = $1; }
    | array_access { $$ = $1; }
    ;

primary_expression:
    IDENTIFIER { $$ = create_identifier_node($1); }
    | INT_LITERAL { $$ = create_literal_node("int", &$1); }
    | FLOAT_LITERAL { $$ = create_literal_node("float", &$1); }
    | STRING_LITERAL { $$ = create_literal_node("string", $1); }
    | CHAR_LITERAL { $$ = create_literal_node("char", &$1); }
    | TRUE { bool val = true; $$ = create_literal_node("boolean", &val); }
    | FALSE { bool val = false; $$ = create_literal_node("boolean", &val); }
    | NULL_VAL { $$ = create_literal_node("null", NULL); }
    ;

if_statement:
    IF LPAREN expression RPAREN statement { $$ = create_if_node($3, $5, NULL); }
    | IF LPAREN expression RPAREN statement ELSE statement { $$ = create_if_node($3, $5, $7); }
    ;

while_statement:
    WHILE LPAREN expression RPAREN statement { $$ = create_while_node($3, $5); }
    ;

for_statement:
    FOR LPAREN variable_declaration expression SEMICOLON expression RPAREN statement { $$ = create_for_node($3, $4, $6, $8); }
    | FOR LPAREN assignment_statement expression SEMICOLON expression RPAREN statement { $$ = create_for_node($3, $4, $6, $8); }
    | FOR LPAREN SEMICOLON expression SEMICOLON expression RPAREN statement { $$ = create_for_node(NULL, $4, $6, $8); }
    ;

do_while_statement:
    DO statement WHILE LPAREN expression RPAREN SEMICOLON { $$ = create_do_while_node($2, $5); }
    ;

switch_statement:
    SWITCH LPAREN expression RPAREN LBRACE case_list RBRACE { $$ = create_switch_node($3, $6); }
    ;

case_list:
    case_statement {
        ASTNode *list = create_list_node();
        add_to_list(list, $1);
        $$ = list;
    }
    | case_list case_statement {
        add_to_list($1, $2);
        $$ = $1;
    }
    ;

case_statement:
    CASE INT_LITERAL COLON statement_list { $$ = create_case_node($2, $4); }
    | DEFAULT COLON statement_list { $$ = create_case_node(-1, $3); }
    ;

function_call:
    PRINTLN LPAREN argument_list RPAREN { $$ = create_function_call_node("System.out.println", $3); }
    | PRINT LPAREN argument_list RPAREN { $$ = create_function_call_node("System.out.print", $3); }
    | PARSE_INT LPAREN expression RPAREN {
        ASTNode *args = create_list_node();
        add_to_list(args, $3);
        $$ = create_function_call_node("Integer.parseInt", args);
    }
    | PARSE_FLOAT LPAREN expression RPAREN {
        ASTNode *args = create_list_node();
        add_to_list(args, $3);
        $$ = create_function_call_node("Float.parseFloat", args);
    }
    | VALUE_OF LPAREN expression RPAREN {
        ASTNode *args = create_list_node();
        add_to_list(args, $3);
        $$ = create_function_call_node("String.valueOf", args);
    }
    ;

argument_list:
    { $$ = create_list_node(); }
    | expression {
        ASTNode *list = create_list_node();
        add_to_list(list, $1);
        $$ = list;
    }
    | argument_list COMMA expression {
        add_to_list($1, $3);
        $$ = $1;
    }
    ;

array_access:
    IDENTIFIER LBRACKET expression RBRACKET {
        // CORRECCIÓN: Se debe crear un nodo identificador para el arreglo
        $$ = create_array_access_node(create_identifier_node($1), $3);
    }
    ;

array_initialization:
    LBRACE argument_list RBRACE {
        // Asumiendo que existe una función create_array_init_node y está en ast.h
        // Si no existe, esta línea necesitará ajustarse.
        // $$ = create_array_init_node($2);
        $$ = $2; // De momento, solo pasamos la lista de argumentos.
    }
    ;

type_specifier:
    INT { $$ = strdup("int"); }
    | FLOAT { $$ = strdup("float"); }
    | DOUBLE { $$ = strdup("double"); }
    | BOOLEAN { $$ = strdup("boolean"); }
    | CHAR { $$ = strdup("char"); }
    | STRING_TYPE { $$ = strdup("String"); }
    ;

assignment_operator:
    ASSIGN { $$ = strdup("="); }
    | PLUS_ASSIGN { $$ = strdup("+="); }
    | MINUS_ASSIGN { $$ = strdup("-="); }
    | MULT_ASSIGN { $$ = strdup("*="); }
    | DIV_ASSIGN { $$ = strdup("/="); }
    | MOD_ASSIGN { $$ = strdup("%="); }
    ;

%%

// FUNCIÓN DE ERROR
void yyerror(const char *s) {
    // CORRECCIÓN: Se usó la función correcta 'add_error' y el enum 'ERROR_SYNTACTIC'
    // También se corrigió la variable global a 'has_errors'
    add_error(ERROR_SYNTACTIC, s, "Global", line_num, col_num);
    has_errors = true;
}