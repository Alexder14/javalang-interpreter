void parse_arguments(int argc, char **argv) {
    static struct option long_options[] = {
        {"reports",    no_argument, 0, 'r'},
        {"graphviz",   no_argument, 0, 'g'},
        {"visualize",  no_argument, 0, 'V'},
        {"verbose",    no_argument, 0, 'v'},
        {"help",       no_argument, 0, 'h'},
        {0, 0, 0, 0}
    };
    
    int option_index = 0;
    int c;
    
    while ((c = getopt_long(argc, argv, "rgVvh", long_options, &option_index)) != -1) {
        switch (c) {
            case 'r':
                show_reports = true;
                break;
            case 'g':
                show_graphviz = true;
                break;
            case 'V':
                visualize_all = true;
                show_reports = true;
                show_graphviz = true;
                break;
            case 'v':
                verbose_mode = true;
                break;
            case 'h':
                print_help(argv[0]);
                exit(0);
            case '?':
                fprintf(stderr, "❌ Opción desconocida. Use -h para ayuda.\n");
                exit(1);
            default:
                abort();
        }
    }
}

void print_phase_separator() {
    printf("═══════════════════════════════════════════════════════════\n");
}

void print_verbose_info(const char *phase, const char *description) {
    if (verbose_mode) {
        printf("🔍 %s: %s\n", phase, description);
    }
}

void print_phase_header(const char *phase) {
    printf("📖 %s\n", phase);
}

void print_symbol_table_report() {
    if (!show_reports && !visualize_all) return;
    
    printf("\n");
    print_phase_separator();
    printf("📊 REPORTE DE TABLA DE SÍMBOLOS\n");
    print_phase_separator();
    
    printf("%-15s %-12s %-10s %-10s %-6s %-8s\n", 
           "ID", "Tipo Símbolo", "Tipo Dato", "Ámbito", "Línea", "Columna");
    printf("─────────────────────────────────────────────────────────────────\n");
    
    // TODO: Implementar reporte real de tabla de símbolos
    printf("%-15s %-12s %-10s %-10s %-6d %-8d\n", 
           "main", "Función", "void", "Global", 1, 1);
    
    // Placeholder - en implementación real vendría de la tabla de símbolos
    if (verbose_mode) {
        printf("\n💡 Información detallada de símbolos disponible en modo verbose\n");
    }
}

void print_error_report() {
    if (!show_reports && !visualize_all) return;
    
    printf("\n");
    print_phase_separator();
    printf("🚨 REPORTE DE ERRORES\n");
    print_phase_separator();
    
    if (error_count > 0) {
        print_error_report();
    } else {
        printf("✅ No se encontraron errores\n");
    }
}

void generate_ast_graphviz() {
    if (!show_graphviz && !visualize_all) return;
    
    printf("\n");
    print_phase_separator();
    printf("🌳 GENERANDO VISUALIZACIÓN DEL AST\n");
    print_phase_separator();
    
    if (ast_root) {
        printf("📄 Generando archivo: ast_output.dot\n");
        
        FILE *dot_file = fopen("ast_output.dot", "w");
        if (dot_file) {
            fprintf(dot_file, "digraph AST {\n");
            fprintf(dot_file, "  rankdir=TB;\n");
            fprintf(dot_file, "  node [shape=box, style=filled, fillcolor=lightblue];\n");
            
            // TODO: Implementar generación real del grafo
            fprintf(dot_file, "  root [label=\"PROGRAM\"];\n");
            fprintf(dot_file, "  main [label=\"MAIN_CLASS\"];\n");
            fprintf(dot_file, "  root -> main;\n");
            
            fprintf(dot_file, "}\n");
            fclose(dot_file);
            
            printf("✅ Archivo ast_output.dot generado\n");
            printf("💡 Para visualizar: dot -Tpng ast_output.dot -o ast.png\n");
        } else {
            printf("❌ Error al crear archivo ast_output.dot\n");
        }
    } else {
        printf("⚠️  No hay AST disponible para visualizar\n");
    }
}

int main(int argc, char **argv) {
    // Verificar argumentos mínimos
    if (argc < 2) {
        print_help(argv[0]);
        return 1;
    }
    
    // Parsear argumentos de línea de comandos
    parse_arguments(argc, argv);
    
    // Verificar que quede al menos un archivo
    if (optind >= argc) {
        print_help(argv[0]);
        return 1;
    }
    
    char *filename = argv[optind];
    
    // Mostrar header
    print_header();
    printf("🔍 Analizando archivo: %s\n", filename);
    
    if (verbose_mode) {
        printf("🛠️  Opciones activas:\n");
        printf("   - Reportes: %s\n", show_reports ? "Sí" : "No");
        printf("   - Graphviz: %s\n", show_graphviz ? "Sí" : "No");
        printf("   - Verbose: %s\n", verbose_mode ? "Sí" : "No");
        printf("   - Visualizar todo: %s\n", visualize_all ? "Sí" : "No");
    }
    
    print_phase_separator();
    
    // Verificar extensión del archivo
    char *ext = strrchr(filename, '.');
    if (!ext || strcmp(ext, ".usl") != 0) {
        printf("⚠️  Advertencia: El archivo no tiene extensión .usl\n");
    }
    
    // Abrir archivo
    yyin = fopen(filename, "r");
    if (!yyin) {
        printf("❌ Error: No se puede abrir el archivo '%s'\n", filename);
        return 1;
    }
    
    // Inicializar variables globales
    ast_root = NULL;
    has_syntax_errors = false;
    line_num = 1;
    col_num = 1;
    error_count = 0;
    
    // Fases de compilación
    print_phase_header("Fase 1: Análisis Léxico");
    print_verbose_info("LEXER", "Tokenizando archivo fuente");
    
    print_phase_header("Fase 2: Análisis Sintáctico");
    print_verbose_info("PARSER", "Verificando gramática y construyendo AST");
    
    print_phase_header("Fase 3: Construcción del AST");
    print_verbose_info("AST", "Creando árbol de sintaxis abstracta");
    
    // Ejecutar análisis sintáctico (incluye léxico)
    int parse_result = yyparse();
    
    // Cerrar archivo
    fclose(yyin);
    
    // Verificar resultados del parsing
    if (parse_result != 0 || has_syntax_errors) {
        printf("❌ Error en análisis sintáctico\n");
        print_error_report();
        return 1;
    }
    
    printf("✅ Análisis sintáctico completado exitosamente\n");
    
    // Fase 4: Análisis Semántico
    print_phase_header("Fase 4: Análisis Semántico");
    print_verbose_info("SEMANTIC", "Validando tipos y ámbitos");
    
    if (ast_root) {
        printf("✅ AST construido correctamente\n");
        
        // TODO: Aquí iría el análisis semántico real
        printf("✅ Análisis semántico completado\n");
        
        // Mostrar información del AST en modo verbose
        if (verbose_mode) {
            printf("🌳 Información del AST:\n");
            printf("   - Tipo de nodo raíz: %d\n", ast_root->type);
            printf("   - Línea: %d, Columna: %d\n", ast_root->line, ast_root->column);
        }
    } else {
        printf("❌ Error: No se pudo construir el AST\n");
        return 1;
    }
    
    // Generar reportes si se solicitaron
    print_symbol_table_report();
    print_error_report();
    generate_ast_graphviz();
    
    // Resumen final
    printf("\n");
    print_phase_separator();
    printf("🎉 COMPILACIÓN COMPLETADA EXITOSAMENTE\n");
    print_phase_separator();
    printf("✅ Análisis léxico: Completado\n");
    printf("✅ Análisis sintáctico: Completado\n");
    printf("✅ Construcción del AST: Completado\n");
    printf("✅ Análisis semántico: Completado\n");
    
    if (show_reports || visualize_all) {
        printf("✅ Reportes generados\n");
    }
    
    if (show_graphviz || visualize_all) {
        printf("✅ Visualización del AST generada\n");
    }
    
    printf("\n🚀 Listo para Fase 5: Ejecución del código\n");
    
    // Limpiar memoria
    if (ast_root) {
        free_ast(ast_root);
    }
    
    return 0;
}