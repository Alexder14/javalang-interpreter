
public static void main(String[] args) {
    int contador = 0;
    float precio = 19.99f;
    boolean activo = true;
    String mensaje = "JavaLang funciona!";
    
    contador = contador + 1;
    precio = precio * 1.1f;
    activo = !activo;
    
    if (contador > 0) {
        mensaje = "Contador positivo";
    }
    
    while (contador < 5) {
        contador++;
    }
    
    int[] numeros = new int[3];
    numeros[0] = 10;
    numeros[1] = 20;
    numeros[2] = 30;
    
    System.out.println(mensaje);
    System.out.println(contador);
}
EOF

