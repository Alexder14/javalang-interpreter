# Crear archivo de ámbitos
cat > examples/semantico_ambitos.usl << 'EOF'
public static void main(String[] args) {
    int global = 10;
    
    if (global > 5) {
        int local = 20;
        global = local + 5;
    }
    
    for (int i = 0; i < 3; i++) {
        int temporal = i * 2;
        global = temporal;
    }
}
EOF